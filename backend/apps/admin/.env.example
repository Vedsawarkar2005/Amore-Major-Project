# Copy this file to .env.local in this app directory; never place app values at the repo root.
# Next.js sets NODE_ENV automatically. APP_ENV describes the deployment, not the build mode.
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3001
NEXT_PUBLIC_API_URL=http://127.0.0.1:8787

# Sentry: DSN is required in preview/production; org/project are additionally required in production.
# The server-only token is optional and enables authenticated source-map upload when supplied.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# PostHog: optional. Supplying either production value requires the complete key/host pair.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=

{
  "name": "@amore/admin",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "type": "module",
  "license": "SEE LICENSE IN ../../LICENSE.md",
  "scripts": {
    "dev": "next dev --port 3001",
    "dev:local": "node --import ../../scripts/dev-env.ts node_modules/next/dist/bin/next dev --hostname 127.0.0.1 --port 3101",
    "clean": "rimraf .next .turbo dist build coverage *.tsbuildinfo next-env.d.ts",
    "clean:dependencies": "rimraf node_modules",
    "build": "next build",
    "start": "next start --port 3001",
    "lint": "biome lint src instrumentation-client.ts next.config.ts",
    "typecheck": "next typegen && tsc --project tsconfig.json"
  },
  "dependencies": {
    "@amore/config": "workspace:*",
    "@amore/contracts": "workspace:*",
    "@amore/auth": "workspace:*",
    "@amore/analytics": "workspace:*",
    "@amore/env": "workspace:*",
    "@amore/observability": "workspace:*",
    "@amore/ui": "workspace:*",
    "@sentry/nextjs": "10.73.0",
    "@tanstack/react-query": "5.102.8",
    "@vercel/analytics": "2.0.1",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.4.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "postcss": "8.5.28",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2"
  }
}

{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "amore-api-dev",
  "main": "src/index.ts",
  // Pin runtime behavior so deployments remain reproducible as Workers evolves.
  "compatibility_date": "2026-09-07",
  "compatibility_flags": ["nodejs_compat", "nodejs_compat_do_not_populate_process_env"],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true
  },
  "dev": {
    "ip": "127.0.0.1",
    "port": 8787
  },
  // Declaring names makes local/deploy validation and generated types independent of env files.
  "secrets": {
    "required": ["DATABASE_URL", "BETTER_AUTH_SECRET"]
  },
  // These values are public routing configuration. Put secrets in .env.local or Wrangler Secrets.
  "vars": {
    "APP_ENV": "development",
    "API_URL": "http://127.0.0.1:8787",
    "LANDING_URL": "http://localhost:3000",
    "STORE_URL": "http://store.localhost:3000",
    "ADMIN_URL": "http://admin.localhost:3000"
  },
  "env": {
    "production": {
      "name": "amore-api",
      "workers_dev": false,
      "preview_urls": false,
      // Secret configuration is non-inheritable across named Wrangler environments.
      "secrets": {
        "required": ["DATABASE_URL", "BETTER_AUTH_SECRET"]
      },
      "routes": [
        {
          "pattern": "api.amorecosmetics.in",
          "custom_domain": true
        }
      ],
      "vars": {
        "APP_ENV": "production",
        "API_URL": "https://api.amorecosmetics.in",
        "LANDING_URL": "https://amorecosmetics.in",
        "STORE_URL": "https://store.amorecosmetics.in",
        "ADMIN_URL": "https://admin.amorecosmetics.in"
      }
    }
  }
}

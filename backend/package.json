{
  "name": "amore-cosmetics",
  "private": true,
  "license": "SEE LICENSE IN LICENSE.md",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "check": "bun run check:agents && biome check .",
    "check:agents": "bun scripts/check-agent-config.ts",
    "check:ci": "bun run check:agents && biome ci .",
    "check:write": "biome check --write .",
    "commitlint": "commitlint",
    "typecheck": "tsc --project tsconfig.json && turbo run typecheck",
    "dev": "turbo run dev:local",
    "dev:stream": "turbo run dev:local --ui=stream --log-prefix=task",
    "dev:preflight": "bun scripts/dev-preflight.ts",
    "dev:proxy": "bun scripts/dev.ts",
    "clean": "bun run clean:artifacts && bun run clean:dependencies",
    "clean:artifacts": "turbo run clean && rimraf .turbo coverage test-results dist build",
    "clean:dependencies": "turbo run clean:dependencies && rimraf node_modules",
    "dev:store": "turbo run dev --filter=@amore/store",
    "dev:admin": "turbo run dev --filter=@amore/admin",
    "dev:api": "turbo run dev --filter=@amore/api-worker",
    "email:dev": "turbo run dev --filter=@amore/emails",
    "build:store": "turbo run build --filter=@amore/store",
    "build:admin": "turbo run build --filter=@amore/admin",
    "build:api": "turbo run build --filter=@amore/api-worker",
    "email:build": "turbo run preview:build --filter=@amore/emails",
    "typecheck:store": "turbo run typecheck --filter=@amore/store",
    "typecheck:admin": "turbo run typecheck --filter=@amore/admin",
    "typecheck:api": "turbo run typecheck --filter=@amore/api-worker",
    "typecheck:emails": "turbo run typecheck --filter=@amore/emails",
    "deploy:api": "bun run --cwd apps/api deploy",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "sort:classes": "biome lint --write --unsafe --only=nursery/useSortedClasses .",
    "lint": "biome lint .",
    "prepare": "lefthook install",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "storybook": "turbo run storybook --filter=@amore/ui",
    "storybook:build": "turbo run build-storybook --filter=@amore/ui",
    "changeset": "changeset",
    "changeset:status": "changeset status",
    "release:version": "changeset version"
  },
  "devDependencies": {
    "@amore/config": "workspace:*",
    "@axe-core/playwright": "4.13.0",
    "@biomejs/biome": "2.5.12",
    "@changesets/cli": "3.0.2",
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@commitlint/types": "21.2.0",
    "@playwright/test": "1.63.0",
    "@types/node": "26.4.1",
    "@vitest/coverage-v8": "5.0.0",
    "http-proxy-middleware": "4.2.0",
    "lefthook": "2.1.12",
    "rimraf": "6.1.2",
    "turbo": "2.10.12",
    "typescript": "7.0.2",
    "vitest": "5.0.0"
  },
  "packageManager": "bun@1.4.1"
}

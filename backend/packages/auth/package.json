  "peerDependencies": {
    "react": ">=19"
  },
  "devDependencies": {
    "@types/react": "19.2.18",
    "@types/node": "26.4.1",
    "rimraf": "6.1.2",
    "typescript": "7.0.2",
    "vitest": "5.0.0"
  }

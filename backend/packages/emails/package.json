{
  "name": "@amore/emails",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "SEE LICENSE IN ../../LICENSE.md",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./render": "./src/render.ts",
    "./welcome": "./src/emails/welcome.tsx"
  },
  "scripts": {
    "clean": "rimraf .react-email .turbo dist build coverage *.tsbuildinfo",
    "clean:dependencies": "rimraf node_modules",
    "dev": "email dev --dir src/emails --port 3002",
    "lint": "biome lint src",
    "preview:build": "email build --dir src/emails",
    "test": "vitest run --root ../.. --config vitest.config.ts packages/emails/src",
    "typecheck": "tsc --project tsconfig.json"
  },
  "dependencies": {
    "@amore/config": "workspace:*",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-email": "6.9.3"
  },
  "devDependencies": {
    "@react-email/ui": "6.9.3",
    "@types/node": "26.4.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "rimraf": "6.1.2",
    "typescript": "7.0.2",
    "vitest": "5.0.0"
  }
}

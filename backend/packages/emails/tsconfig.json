{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "Email templates",
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    // Templates render on servers but use React's JSX transform at authoring time.
    "jsx": "react-jsx",
    "lib": ["DOM", "ESNext"],
    "types": ["node"]
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"]
}

{
  "name": "@amore/ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "SEE LICENSE IN ../../LICENSE.md",
  "sideEffects": [
    "**/*.css"
  ],
  "imports": {
    "#components/*": "./src/components/*.tsx",
    "#hooks/*": "./src/hooks/*.ts",
    "#lib/*": "./src/lib/*.ts"
  },
  "exports": {
    ".": "./src/index.ts",
    "./components/data-display": "./src/components/data-display/index.ts",
    "./components/feedback": "./src/components/feedback/index.ts",
    "./components/forms": "./src/components/forms/index.ts",
    "./components/layout": "./src/components/layout/index.ts",
    "./components/primitives": "./src/components/primitives/index.ts",
    "./components/*": "./src/components/*.tsx",
    "./hooks": "./src/hooks/index.ts",
    "./hooks/*": "./src/hooks/*.ts",
    "./lib/*": "./src/lib/*.ts",
    "./styles.css": "./src/styles/globals.css",
    "./themes.css": "./src/styles/themes.css",
    "./typeset.css": "./src/styles/typeset.css",
    "./theme": "./src/theme/index.ts",
    "./theme/client": "./src/theme/client.ts"
  },
  "scripts": {
    "storybook": "storybook dev --port 6006",
    "build-storybook": "storybook build",
    "clean": "rimraf .turbo dist build coverage storybook-static *.tsbuildinfo",
    "clean:dependencies": "rimraf node_modules",
    "lint": "biome lint src .storybook",
    "typecheck": "tsc --project tsconfig.json"
  },
  "dependencies": {
    "@base-ui/react": "1.8.0",
    "@shadcn/react": "^0.3.1",
    "@wrksz/themes": "1.2.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "cn": "^0.2.6",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.5.0",
    "lucide-react": "1.41.0",
    "react-day-picker": "^10.0.1",
    "react-resizable-panels": "^4.12.4",
    "recharts": "3.8.0",
    "sonner": "2.0.8",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0"
  },
  "peerDependencies": {
    "next": ">=16",
    "react": ">=19",
    "react-dom": ">=19"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "10.6.0",
    "@storybook/addon-docs": "10.6.0",
    "@storybook/addon-themes": "10.6.0",
    "@storybook/react-vite": "10.6.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.4.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "storybook": "10.6.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "5.0.0"
  }
}

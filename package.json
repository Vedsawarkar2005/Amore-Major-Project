{
  "name": "amore-full-web",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n \"API,WEB\" -c \"magenta,cyan\" \"npm run dev --workspace=apps/api\" \"npm run dev --workspace=apps/web\"",
    "dev:all": "concurrently -n \"API,WEB,AI\" -c \"magenta,cyan,yellow\" \"npm run dev --workspace=apps/api\" \"npm run dev --workspace=apps/web\" \"python apps/shade-recom/main.py\"",
    "dev:web": "npm run dev --workspace=apps/web",
    "dev:api": "npm run dev --workspace=apps/api",
    "dev:ai": "python apps/shade-recom/main.py",
    "build": "echo \"No build required\"",
    "build:web": "npm run build --workspace=apps/web",
    "start": "node apps/api/src/server.js",
    "seed": "npm run seed --workspace=apps/api",
    "install:all": "npm install"
  },
  "allowScripts": {
    "unrs-resolver": true
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  },
  "dependencies": {
    "@neon/config": "^1.8.3",
    "@neon/env": "^1.4.8"
  }
}
